# -----------------------------------------------------------------------------
# Dhira Industries - Environment Variable Template
# Copy this file to .env (and .env.local for local overrides) and fill in
# real values. NEVER commit actual secrets.
# -----------------------------------------------------------------------------

# App
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Dhira Industries"

# Database (PostgreSQL - see docker-compose.yml for local dev)
DATABASE_URL="postgresql://dhira:dhira_dev_password@localhost:5432/dhira_commerce?schema=public"

# Redis (caching / rate limiting / sessions - see docker-compose.yml for local dev)
REDIS_URL="redis://localhost:6379"

# Auth / Admin session
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_SESSION_COOKIE_NAME="dhira_admin_session"

# -----------------------------------------------------------------------------
# Development-only admin bootstrap credentials.
# Used ONLY by `npm run db:seed` to create/update a local development admin
# account. Never set these in production - the seed refuses to run them when
# NODE_ENV=production. Choose your own values locally; do not reuse real
# passwords here.
# -----------------------------------------------------------------------------
DEV_ADMIN_NAME="Dhira Dev Admin"
DEV_ADMIN_EMAIL="admin@dhira.local"
DEV_ADMIN_PASSWORD="choose-a-local-dev-password"

# -----------------------------------------------------------------------------
# Payments - Cashfree (NOT implemented in Phase 1, placeholders only)
# -----------------------------------------------------------------------------
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="TEST"
CASHFREE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Shipping - Shiprocket (NOT implemented in Phase 1, placeholders only)
# -----------------------------------------------------------------------------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_API_BASE_URL="https://apiv2.shiprocket.in/v1/external"

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@dhiraindustries.com"

# -----------------------------------------------------------------------------
# Analytics (NOT implemented in Phase 1, placeholders only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# -----------------------------------------------------------------------------
# Storage / Media (e.g. S3-compatible bucket for product & content images)
# -----------------------------------------------------------------------------
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
