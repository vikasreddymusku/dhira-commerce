// Dhira Industries - Core Commerce Domain Schema (Phase 1)
// Modular monolith: single Postgres database, domain-grouped models.
// Keep models minimal but structurally correct; expand in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum WeightUnit {
  G
  KG
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  CASHFREE
  COD
  MANUAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RTO
}

enum ShipmentProvider {
  SHIPROCKET
  MANUAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum B2BEnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

// ---------------------------------------------------------------------------
// Admin / Access
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCategory[]

  @@map("categories")
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]

  @@map("collections")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?
  originStory      String?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants    ProductVariant[]
  categories  ProductCategory[]
  collections ProductCollection[]
  reviews     Review[]
  recipes     RecipeProduct[]
  wishlisted  WishlistItem[]

  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model ProductVariant {
  id             String     @id @default(cuid())
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String     @unique
  label          String
  weightValue    Decimal    @db.Decimal(10, 2)
  weightUnit     WeightUnit @default(G)
  priceInPaise   Int
  compareAtPaise Int?
  isDefault      Boolean    @default(false)
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  inventory  InventoryItem?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryItem {
  id               String         @id @default(cuid())
  variantId        String         @unique
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderPoint     Int            @default(0)
  stockStatus      StockStatus    @default(IN_STOCK)
  warehouseLabel   String         @default("Primary Warehouse")
  updatedAt        DateTime       @updatedAt

  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String?
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses Address[]
  carts     Cart[]
  wishlist  WishlistItem[]
  orders    Order[]
  reviews   Review[]

  @@map("customers")
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       AddressType @default(SHIPPING)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("IN")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Cart / Wishlist
// ---------------------------------------------------------------------------

model Cart {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId  String?   @unique
  currency   String    @default("INR")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Orders / Payments / Shipments
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR")
  subtotalInPaise Int
  shippingInPaise Int         @default(0)
  discountInPaise Int         @default(0)
  taxInPaise      Int         @default(0)
  totalInPaise    Int
  shippingAddress Json
  billingAddress  Json?
  customerEmail   String
  customerPhone   String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items     OrderItem[]
  payments  Payment[]
  refunds   Refund[]
  shipments Shipment[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  productName      String
  variantLabel     String
  sku              String
  quantity         Int
  unitPriceInPaise Int
  totalInPaise     Int

  @@map("order_items")
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider @default(CASHFREE)
  status        PaymentStatus   @default(PENDING)
  amountInPaise Int
  currency      String          @default("INR")
  providerRef   String?
  rawResponse   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String?
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  status        RefundStatus @default(REQUESTED)
  amountInPaise Int
  reason        String?
  providerRef   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("refunds")
}

model Shipment {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       ShipmentProvider @default(MANUAL)
  status         ShipmentStatus   @default(PENDING)
  trackingNumber String?
  trackingUrl    String?
  courierName    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Marketing / Discounts / Reviews
// ---------------------------------------------------------------------------

model Discount {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  type            DiscountType
  value           Int
  minOrderInPaise Int?
  maxUses         Int?
  usedCount       Int          @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("discounts")
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String?
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Content: Recipes / Blog / Homepage / FAQ / Policies
// ---------------------------------------------------------------------------

model Recipe {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  body        String?
  imageUrl    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products RecipeProduct[]

  @@map("recipes")
}

model RecipeProduct {
  recipeId  String
  productId String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([recipeId, productId])
  @@map("recipe_products")
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  body          String?
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("blog_posts")
}

model HomepageSection {
  id        String        @id @default(cuid())
  key       String        @unique
  title     String?
  subtitle  String?
  content   Json?
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt

  @@map("homepage_sections")
}

model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("faqs")
}

model Policy {
  id        String        @id @default(cuid())
  key       String        @unique
  title     String
  body      String
  status    ContentStatus @default(PUBLISHED)
  updatedAt DateTime      @updatedAt

  @@map("policies")
}

// ---------------------------------------------------------------------------
// B2B / Settings / Integrations
// ---------------------------------------------------------------------------

model B2BEnquiry {
  id          String           @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  requirement String
  status      B2BEnquiryStatus @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("b2b_enquiries")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  provider  String   @unique
  isEnabled Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt

  @@map("integration_settings")
}
